# =========================================================================
# SAU YUL-TECH - PLANTILLA DE VARIABLES DE ENTORNO PRINCIPAL (.env.example)
# =========================================================================

# Puerto del Servidor Local (por defecto 3000)
PORT=3000

# Base de Datos Firebase Realtime Database
FIREBASE_DATABASE_URL=https://datosbase111-default-rtdb.firebaseio.com
FIREBASE_AUTH=TU_TOKEN_PRIVADO_FIREBASE

# Credenciales de Administrador Maestro
MASTER_USER=Shadow
MASTER_PASS=CAMBIA_ESTA_CLAVE

# Configuración de Proyecto Firebase (sou-youl-tech)
FIREBASE_PROJECT_ID=sou-youl-tech
FIREBASE_AUTH_DOMAIN=sou-youl-tech.firebaseapp.com
FIREBASE_STORAGE_BUCKET=sou-youl-tech.firebasestorage.app
FIREBASE_API_KEY=TU_FIREBASE_API_KEY
FIREBASE_MESSAGING_SENDER_ID=TU_SENDER_ID
FIREBASE_APP_ID=TU_FIREBASE_APP_ID
FIREBASE_MEASUREMENT_ID=TU_MEASUREMENT_ID

# Nombre de la Base de Datos Local de respaldo (solo para Node.js local)
DATA_FILE=bovineintel-db.json
